# Every text file in the repository is committed with LF line endings.
# Nothing here converts or filters file contents on checkout or in an
# archive: Anthropic's plugin directory stops validating a repository whose
# .gitattributes rewrites file contents.

# Binary-like files: no diff, no merge, no line conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.mov binary
*.zip binary
*.tar.gz binary

# Lock files: no textual diff
package-lock.json -diff
pnpm-lock.yaml -diff
yarn.lock -diff
