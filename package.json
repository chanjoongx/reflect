{
  "name": "@chanjoongx/reflect",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A Claude Code plugin that notices when you keep pushing back on the agent, works out why, and tells the agent before its next step.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "reflect": "hooks/reflect-hook.mjs"
  },
  "files": [
    "hooks/hooks.json",
    "hooks/reflect-hook.mjs",
    "hooks/lib/",
    "hooks/THIRD_PARTY_LICENSES.txt",
    "commands/",
    ".claude-plugin/plugin.json",
    ".env.example",
    "README.md",
    "ARCHITECTURE.md",
    "PRIVACY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": {
    "name": "Chanjoong Kim",
    "email": "cj@chanjoongx.com",
    "url": "https://chanjoongx.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanjoongx/reflect.git"
  },
  "bugs": {
    "url": "https://github.com/chanjoongx/reflect/issues"
  },
  "homepage": "https://github.com/chanjoongx/reflect",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "claude-code-hooks",
    "claude",
    "anthropic",
    "metacognition",
    "session-local",
    "reflection",
    "pushback",
    "correction-detection",
    "ai-agents",
    "ai-coding",
    "developer-tools"
  ],
  "dependencies": {},
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "node scripts/build-hook.mjs",
    "check:bundle": "node scripts/build-hook.mjs --check",
    "reflect": "tsx src/entry.ts",
    "test": "npm run typecheck && node --test --import tsx \"src/**/*.test.ts\" \"bench/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p bench/tsconfig.json",
    "mirror-check": "diff -q src/redact.ts web/lib/redact.ts",
    "viewer": "npm run preview --prefix web",
    "viewer:dev": "npm run dev --prefix web",
    "viewer:build": "npm run build --prefix web",
    "bench:extract": "tsx bench/extract.ts",
    "bench:label": "tsx bench/label.ts",
    "bench:score": "tsx bench/score.ts",
    "bench:report": "tsx bench/report.ts",
    "bench:review": "tsx bench/review.ts",
    "bench:sim": "tsx bench/session-sim.ts",
    "bench": "npm run bench:score && npm run bench:report && npm run bench:sim",
    "smoke": "node scripts/smoke.mjs"
  }
}
